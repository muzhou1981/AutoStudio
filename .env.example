# 复制为 .env 后填写；.env 不纳入版本库
CURSOR_API_KEY=
LANGSMITH_API_KEY=
# 关闭后运行数据只留在本地 langgraph dev 服务
LANGSMITH_TRACING=false

# --- 飞书 HITL（ADR 0003 / 0004）---
# 推荐：个人开发者应用 + 官方 lark-cli（公司租户未开开放平台时）
AUTO_STUDIO_LARK_BACKEND=lark_cli
# 凭据在 lark-cli 本地配置中：lark-cli config init --new（勿提交仓库）

# 可选：直连 Bot（AUTO_STUDIO_LARK_BACKEND=env_bot 时使用）
LARK_APP_ID=
LARK_APP_SECRET=
# 事件订阅（卡片回调、入站消息）启用后填写；适配层上线后用于验签
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=
# 交互卡片「在 Web 中打开」链接前缀，如 http://127.0.0.1:8766
AUTO_STUDIO_PUBLIC_BASE_URL=
