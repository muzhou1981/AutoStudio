# 复制为 .env 后填写；.env 不纳入版本库（Web / smoke 启动时加载；smoke 默认覆盖 shell 中同名变量）
CURSOR_API_KEY=
AUTO_STUDIO_CURSOR_MODEL=composer-2
# 设为 0 跳过 Cursor.me 校验（仅本地调试）
AUTO_STUDIO_CURSOR_VERIFY=1
# 可选：连接已有 Bridge（否则 SDK 尝试 Bridge.launch）
# CURSOR_SDK_BRIDGE_URL=
# CURSOR_SDK_BRIDGE_TOKEN=
LANGSMITH_API_KEY=
# 关闭后运行数据只留在本地 langgraph dev 服务
LANGSMITH_TRACING=false

# --- 飞书 HITL（ADR 0003 / 0004）---
# 推荐：个人开发者应用 + 官方 lark-cli（公司租户未开开放平台时）
AUTO_STUDIO_LARK_BACKEND=lark_cli
# 凭据在 lark-cli 本地配置中：lark-cli config init --new（勿提交仓库）

# 可选：直连 Bot（AUTO_STUDIO_LARK_BACKEND=env_bot 时使用）
LARK_APP_ID=
LARK_APP_SECRET=
# 事件订阅（卡片回调、入站消息）启用后填写；适配层上线后用于验签
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=
# 交互卡片「在 Web 中打开」链接前缀，如 http://127.0.0.1:8766
AUTO_STUDIO_PUBLIC_BASE_URL=
# 无 project.yaml hitl 段时仍可从环境变量出站（联调 smoke）
AUTO_STUDIO_FEISHU_NOTIFY_OPEN_ID=
AUTO_STUDIO_FEISHU_NOTIFY_CHAT_ID=
